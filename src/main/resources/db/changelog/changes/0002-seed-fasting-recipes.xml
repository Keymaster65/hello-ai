    <!-- Seed data: the classic Buchinger therapeutic fasting cycle (Entlastungstag, Fastentage,
         Fastenbrechen, Aufbautag). Marked with context "seed" so a deployment can skip it via
         spring.liquibase.contexts; without a runtime context Liquibase runs it.

         The identifiers are GENERATED ALWAYS, so child rows resolve their recipe via a subselect
         on the (unique) title instead of hard-coded ids. QUOTE_ALL_OBJECTS as in changeset 0001,
         see ADR 0004. -->
    <changeSet id="0002-seed-fasting-recipes" author="recipe" context="seed"
               objectQuotingStrategy="QUOTE_ALL_OBJECTS">

        <preConditions onFail="MARK_RAN">
            <!-- Only populate an empty database; never duplicate into an existing one. -->
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM "recipe"</sqlCheck>
        </preConditions>


